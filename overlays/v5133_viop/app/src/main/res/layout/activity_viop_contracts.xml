<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            style="@style/Title"
            android:text="VİOP Sözleşmeleri" />

        <TextView
            style="@style/Sub"
            android:layout_marginTop="4dp"
            android:text="İlk harften itibaren sözleşme kodu veya dayanak varlıkla ara." />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/viopBist30"
                    style="@style/ScanFilterButton"
                    android:text="BIST30" />

                <Button
                    android:id="@+id/viopFx"
                    style="@style/ScanFilterButton"
                    android:layout_marginStart="6dp"
                    android:text="DÖVİZ" />

                <Button
                    android:id="@+id/viopCommodity"
                    style="@style/ScanFilterButton"
                    android:layout_marginStart="6dp"
                    android:text="EMTİA" />

                <Button
                    android:id="@+id/viopOther"
                    style="@style/ScanFilterButton"
                    android:layout_marginStart="6dp"
                    android:text="DİĞER" />
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/viopSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Sözleşme ara… Örn: X, U, E"
            android:imeOptions="actionSearch"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/viopSearchHint"
            style="@style/Sub"
            android:layout_marginTop="6dp"
            android:text="Bir harf yazınca en uygun sözleşmeler otomatik listelenir." />

        <LinearLayout
            android:id="@+id/viopSuggestionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_blue"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/viopSuggestionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:text="Otomatik öneriler"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/viopSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="280dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/viopStatus"
            style="@style/Sub"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/viopContractsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp" />

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
