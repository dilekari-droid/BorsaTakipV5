<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Title" android:text="Fırsat Kontrolü" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="BIST hisselerinde şu anda neden ilgi çekici olabilecek yapıları keşfet."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSortOpportunity"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="Sırala"
                android:textColor="@color/blue"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_blue"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Piyasa Rejimi"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtMarketRegime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Benchmark verisi bekleniyor"
                android:textColor="@color/green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rejim verisi yoksa sistem sahte olumlu/olumsuz piyasa yorumu üretmez."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtWatchedCount"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="İzlenen\n—"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFoundCount"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="Fırsat\n—"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDataQuality"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="Veri Kalitesi\n—"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnFilterAll" style="@style/ScanFilterButton" android:minWidth="78dp" android:text="Tümü" />
                <Button android:id="@+id/btnFilterStrongBuy" style="@style/ScanFilterButton" android:minWidth="104dp" android:layout_marginStart="6dp" android:text="Güçlü Al" />
                <Button android:id="@+id/btnFilterWatch" style="@style/ScanFilterButton" android:minWidth="92dp" android:layout_marginStart="6dp" android:text="İzleme" />
                <Button android:id="@+id/btnFilterCatalyst" style="@style/ScanFilterButton" android:minWidth="116dp" android:layout_marginStart="6dp" android:text="Katalizörlü" />
                <Button android:id="@+id/btnFilterLowRisk" style="@style/ScanFilterButton" android:minWidth="112dp" android:layout_marginStart="6dp" android:text="Düşük Risk" />
                <Button android:id="@+id/btnFilterHighVolume" style="@style/ScanFilterButton" android:minWidth="122dp" android:layout_marginStart="6dp" android:text="Yüksek Hacim" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/txtSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fırsat motoru hazır."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRealOpportunityScan"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_blue"
                android:text="FIRSATLARI YENİLE"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSignalHistory"
                android:layout_width="116dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:text="GEÇMİŞ"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:padding="9dp"
            android:text="Skor mantığı: Değerleme • Finansal kalite • Kâr ivmesi • Sürpriz • Fiyat gücü • Momentum • Hacim • Para akışı • KAP/Katalizör • Risk • Veri kalitesi • Piyasa rejimi. Sağlanmayan faktörler puana uydurulmaz; eksik olarak gösterilir."
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
