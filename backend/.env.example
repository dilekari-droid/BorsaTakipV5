# BorsaTakip backend client auth. Leave empty only for local development.
BORSA_BACKEND_API_KEY=change-me

# Licensed/authorized upstream provider name shown to the app.
BORSA_UPSTREAM_NAME=licensed-provider

# Optional bearer token for the upstream provider.
BORSA_UPSTREAM_TOKEN=

# Must return either a JSON array of symbols or {"items":["ASELS","THYAO",...]}
BORSA_SYMBOLS_URL=https://provider.example/v1/bist/symbols

# Must return normalized history JSON documented in backend/README.md.
# {symbol} is replaced safely by the requested BIST symbol.
BORSA_HISTORY_URL_TEMPLATE=https://provider.example/v1/bist/history/{symbol}

# Optional until VIOP is enabled. Must return a JSON array or {"items":[...]}
BORSA_VIOP_URL=https://provider.example/v1/viop/contracts
