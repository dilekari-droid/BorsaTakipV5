# BorsaTakip backend client auth. Generate a strong secret in deployment.
# Never commit the real value.
BORSA_BACKEND_API_KEY=CHANGE_ME_IN_DEPLOYMENT

# Licensed/authorized upstream provider name shown to the app.
BORSA_UPSTREAM_NAME=YOUR_LICENSED_PROVIDER

# Optional provider credential. Keep the real value only in deployment secrets.
BORSA_UPSTREAM_TOKEN=

# REQUIRED for production BIST scanning.
# Must be a REAL licensed/authorized HTTPS endpoint returning either
# ["ASELS","THYAO",...] or {"items":["ASELS","THYAO",...]}.
# Do not use an example domain as if it were a working service.
BORSA_SYMBOLS_URL=

# REQUIRED for production BIST scanning.
# Must be a REAL licensed/authorized HTTPS endpoint template containing {symbol}
# and returning normalized OHLCV + provenance metadata documented in README.md.
BORSA_HISTORY_URL_TEMPLATE=

# OPTIONAL until VIOP is enabled. Leave empty when the licensed provider does not expose it.
BORSA_VIOP_URL=

# Retry policy for transient upstream transport failures. Hard capped to 3 by code.
BORSA_UPSTREAM_MAX_ATTEMPTS=3

# Strict real-time acceptance limits.
BORSA_MAX_REALTIME_AGE_MS=60000
BORSA_MAX_DECLARED_DELAY_SECONDS=5
