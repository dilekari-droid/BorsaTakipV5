<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Title" android:text="BORSA TAKİP" />
                    <TextView
                        android:id="@+id/txtVersionSubtitle"
                        style="@style/Sub"
                        android:text="Profesyonel fırsat takibi"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/txtVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V"
                    android:textStyle="bold"
                    android:textColor="@color/blue"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:text="Borsa fırsatlarını tek ekranda izle; veri kaynağı ve zamanını sonuçlarda doğrula."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBist"
                style="@style/CardButton"
                android:background="@drawable/bg_card_blue"
                android:text="⌕   BIST TARA\n      BIST hisselerini tara ve fırsatları bul" />

            <Button
                android:id="@+id/btnOpportunity"
                style="@style/CardButton"
                android:background="@drawable/bg_card_green"
                android:text="★   FIRSAT KONTROL ET\n      LONG / SHORT sinyallerini güçlerine göre sırala" />

            <Button
                android:id="@+id/btnViop"
                style="@style/CardButton"
                android:background="@drawable/bg_card_purple"
                android:text="▮▮   VİOP TARA\n      Vadeli sözleşmeleri ayrı veri akışıyla incele" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <Button
                    android:id="@+id/btnFav"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="80dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card"
                    android:textColor="@color/text_primary"
                    android:text="★\nTakip Listem" />
                <Button
                    android:id="@+id/btnNotifications"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="80dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:textColor="@color/text_primary"
                    android:text="🔔\nBildirimler" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_secondary"
                android:text="Piyasa Özeti\nKaynak, veri zamanı ve gecikme durumu her sonuç ekranında ayrıca gösterilir." />

            <TextView
                android:id="@+id/txtToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:text="Günün Fırsatları\nHenüz tarama yapılmadı." />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
