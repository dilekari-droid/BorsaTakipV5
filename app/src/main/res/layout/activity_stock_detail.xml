<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView android:id="@+id/title" style="@style/Title" />
            <TextView android:id="@+id/subtitle" style="@style/Sub" android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/signalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="5dp">

                <TextView
                    android:id="@+id/signalLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/signalScores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Genel Görünüm"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/generalOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bu Sinyal Neden Oluştu?"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/signalReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Destek / Direnç"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/supportResistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Gerçek OHLCV Grafik"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:textSize="17sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/period3min" android:layout_width="88dp" android:layout_height="46dp" android:text="3 Dk" />
                    <Button android:id="@+id/period5min" android:layout_width="88dp" android:layout_height="46dp" android:text="5 Dk" />
                    <Button android:id="@+id/period15min" android:layout_width="92dp" android:layout_height="46dp" android:text="15 Dk" />
                    <Button android:id="@+id/period1hour" android:layout_width="96dp" android:layout_height="46dp" android:text="1 Saat" />
                    <Button android:id="@+id/period1day" android:layout_width="92dp" android:layout_height="46dp" android:text="1 Gün" />
                    <Button android:id="@+id/periodAll" android:layout_width="120dp" android:layout_height="46dp" android:text="Tüm Zamanlar" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/chartState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Grafik verisi hazırlanıyor..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <tr.borsatakip.v5.ui.TechnicalOhlcvChartView
                android:id="@+id/ohlcvChart"
                android:layout_width="match_parent"
                android:layout_height="620dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card" />

            <TextView
                android:id="@+id/selectedCandle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:text="Bir muma dokunarak OHLCV ayrıntısını görüntüleyin. Yatay kaydırma ve yakınlaştırma desteklenir."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chartMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Teknik Göstergeler"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Hacim Durumu"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/volumeAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Veri Kalitesi"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/dataQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:textColor="@color/yellow"
                android:text="Önemli: Eksik OHLCV, hacim veya teknik gösterge uydurulmaz; veri yoksa açıkça belirtilir."
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
