<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bu kayıt yalnız geliştirme amacıyla sözleşme metadata'sı tutar. Fiyat, hacim, alış/satış ve açık pozisyon girilmez veya üretilmez."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/inputUnderlying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Dayanak (örn. XU030)"
        android:inputType="textCapCharacters" />

    <EditText
        android:id="@+id/inputExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Vade (YYYY-MM)"
        android:inputType="text" />

    <EditText
        android:id="@+id/inputSymbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Sözleşme kodu"
        android:inputType="textCapCharacters" />
</LinearLayout>
