<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            style="@style/Title"
            android:text="Fırsat Kontrol" />

        <TextView
            android:id="@+id/txtSummary"
            style="@style/Sub"
            android:text="Gerçek BIST verisiyle tarama. KAP verisi yoksa açıkça 0 puan gösterilir." />

        <Button
            android:id="@+id/btnRealOpportunityScan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_blue"
            android:text="GERÇEK FIRSAT TARAMASINI BAŞLAT"
            android:textColor="@color/white" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp" />

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
