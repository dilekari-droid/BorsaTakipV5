<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Title" android:text="Fırsat Kontrol" />
                <TextView android:id="@+id/txtSummary" style="@style/Sub" android:text="LONG / SHORT sonuçları nihai sinyale göre sıralanır." android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/txtFilterState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtre: Tümü"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Aktif filtreler. Dokununca filtreleri temizler." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <TextView
                android:id="@+id/filterLong"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginEnd="5dp" android:background="@drawable/bg_card" android:gravity="center"
                android:padding="10dp" android:text="LONG\nYeşil" android:textColor="@color/green" android:textStyle="bold"
                android:clickable="true" android:focusable="true" android:contentDescription="LONG filtresi" />
            <TextView
                android:id="@+id/filterShort"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp" android:background="@drawable/bg_card" android:gravity="center"
                android:padding="10dp" android:text="SHORT\nKırmızı" android:textColor="@color/red" android:textStyle="bold"
                android:clickable="true" android:focusable="true" android:contentDescription="SHORT filtresi" />
            <TextView
                android:id="@+id/filterHighPower"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:background="@drawable/bg_card" android:gravity="center"
                android:padding="10dp" android:text="85+\nYüksek Güç" android:textColor="@color/yellow" android:textStyle="bold"
                android:clickable="true" android:focusable="true" android:contentDescription="85 ve üzeri sinyal filtresi" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRealOpportunityScan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_blue"
            android:text="FIRSAT TARAMASINI BAŞLAT"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:gravity="center"
        android:text="Bu filtrelere uygun fırsat bulunamadı."
        android:textColor="@color/text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
