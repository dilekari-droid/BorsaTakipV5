<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView style="@style/Title" android:text="Sinyal Geçmişi / Forward Test" />
        <TextView android:id="@+id/historyStatus" style="@style/Sub" android:layout_marginTop="4dp" android:text="Yalnız COMPLETE taramalarda kilitlenen sinyaller gösterilir." />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:textColor="@color/text_primary" android:lineSpacingExtra="5dp" />
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
