<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView style="@style/Title" android:text="BIST Tarama"/><TextView android:id="@+id/txtSource" style="@style/Sub" android:text="Veri kaynağı hazırlanıyor..."/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:padding="14dp"><TextView android:id="@+id/txtProgress" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:text="0 / 0 • %0"/><ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:max="100"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/text_primary" android:textStyle="bold" android:text="Tarama Kriterleri"/>
<com.google.android.material.chip.ChipGroup android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:singleSelection="false" xmlns:app="http://schemas.android.com/apk/res-auto">
<com.google.android.material.chip.Chip android:id="@+id/chipTechnical" style="@style/Widget.MaterialComponents.Chip.Filter" android:text="Teknik" android:checked="true"/><com.google.android.material.chip.Chip android:id="@+id/chipVolume" style="@style/Widget.MaterialComponents.Chip.Filter" android:text="Hacim" android:checked="true"/><com.google.android.material.chip.Chip android:id="@+id/chipBreakout" style="@style/Widget.MaterialComponents.Chip.Filter" android:text="Kırılım"/><com.google.android.material.chip.Chip android:id="@+id/chipBonus" style="@style/Widget.MaterialComponents.Chip.Filter" android:text="Bedelsiz (API)" android:enabled="false"/><com.google.android.material.chip.Chip android:id="@+id/chipDividend" style="@style/Widget.MaterialComponents.Chip.Filter" android:text="Temettü (API)" android:enabled="false"/><com.google.android.material.chip.Chip android:id="@+id/chipLong" style="@style/Widget.MaterialComponents.Chip.Filter" android:text="LONG" android:checked="true"/><com.google.android.material.chip.Chip android:id="@+id/chipShort" style="@style/Widget.MaterialComponents.Chip.Filter" android:text="SHORT" android:checked="true"/></com.google.android.material.chip.ChipGroup>
<Button android:id="@+id/btnStartScan" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_blue" android:textColor="@color/white" android:textStyle="bold" android:text="TARAMAYI BAŞLAT"/>
<TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="12dp" android:textColor="@color/text_secondary" android:text="Hazır"/>
</LinearLayout></ScrollView><include layout="@layout/include_bottom_nav"/></LinearLayout>