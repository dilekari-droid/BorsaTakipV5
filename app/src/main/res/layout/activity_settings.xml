<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/Title" android:text="Ayarlar" />
            <TextView style="@style/Sub" android:text="Üretim modu: HTTPS backend ana kaynak • Yahoo yalnız isteğe bağlı deneysel BIST yedeği" />

            <TextView
                style="@style/Sub"
                android:layout_marginTop="14dp"
                android:text="Üretim BIST/VİOP backend" />

            <EditText
                android:id="@+id/baseUrl"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Gerçek backend HTTPS adresi"
                android:inputType="textUri"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Backend API Key / Bearer Token (varsa)"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <Switch
                android:id="@+id/experimentalProviders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="DENEYSEL yedek veri modunu etkinleştir (yalnız Yahoo BIST)"
                android:textColor="@color/text_primary" />

            <Switch
                android:id="@+id/yahooFallback"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Yahoo Finance gecikmeli BIST yedeğini kullan"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Sub"
                android:layout_marginTop="18dp"
                android:text="TradingView" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:text="TradingView yalnız harici grafik/görüntüleme amacıyla açılır. BorsaTakip TradingView'a WebView ile giriş yapmaz, TradingView cookie/oturumunu uygulamaya aktarmaz ve BIST/VİOP verisini TradingView'dan toplamaz."
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/testTradingViewLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_blue"
                android:text="TRADINGVIEW'DA AÇ"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tradingViewStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/refreshMinutes"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:hint="Yenileme (dakika)"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <Switch
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Fırsat bildirimleri"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_card_blue"
                android:text="KAYDET"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/testConnection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:text="ÜRETİM BACKEND BAĞLANTISINI TEST ET"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/dataStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
