@@ -0,0 +1,37 @@
+package tr.borsatakip.v5.ui
+
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class B146ProviderSetupRedirectSourceTest {
+    private fun source(path: String): String {
+        val candidates = listOf(File("src/main/$path"), File("app/src/main/$path"), File("../app/src/main/$path"))
+        return candidates.firstOrNull { it.exists() }?.readText()
+            ?: error("Source not found: $path")
+    }
+
+    @Test
+    fun lensStartsScanOnlyWhenAConfiguredSourceExists() {
+        val src = source("java/tr/borsatakip/v5/ui/BistScanActivity.kt")
+        assertTrue(src.contains("if (hasConfiguredScanSource())"))
+        assertTrue(src.contains("btn.performClick()"))
+        assertTrue(src.contains("openProviderSetup()"))
+        assertTrue(src.contains("productionBackendConfigured() || userFallbackEnabled()"))
+    }
+
+    @Test
+    fun missingProviderOpensTheSpecificProviderDetail() {
+        val src = source("java/tr/borsatakip/v5/ui/BistScanActivity.kt")
+        assertTrue(src.contains("SettingsDetailActivity.MODE_DATA_CONNECTION"))
+        assertTrue(src.contains("SettingsDetailActivity.MODE_API_KEYS"))
+        assertTrue(src.contains("SettingsDetailActivity.EXTRA_MODE"))
+        assertTrue(src.contains("configure.setOnClickListener { openProviderSetup() }"))
+    }
+
+    @Test
+    fun lensAccessibilityExplainsProviderRedirect() {
+        val layout = source("res/layout/activity_bist_scan.xml")
+        assertTrue(layout.contains("veri kaynağı yoksa sağlayıcı ayarlarını aç"))
+    }
+}
