+package tr.borsatakip.v5.ui
+
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class B145AutoScanStateSourceTest {
+    private fun source(path: String): String {
+        val candidates = listOf(File("src/main/$path"), File("app/src/main/$path"))
+        return candidates.firstOrNull { it.exists() }?.readText()
+            ?: error("Source not found: $path")
+    }
+
+    @Test
+    fun activityUsesSingleAutoScanUiPolicyAndRefreshesDetails() {
+        val src = source("java/tr/borsatakip/v5/ui/BistScanActivity.kt")
+        assertTrue(src.contains("BistAutoScanUiPolicy.resolve("))
+        assertTrue(src.contains("autoScanStatus.text = autoUi.statusLine"))
+        assertTrue(src.contains("refreshScanTimeUi()"))
+    }
+
+    @Test
+    fun schedulerDoesNotStartWithoutAnyProvider() {
+        val src = source("java/tr/borsatakip/v5/worker/AutoScanScheduler.kt")
+        assertTrue(src.contains("if (!productionReady && !fallbackReady)"))
+        assertTrue(src.contains("AutoScanForegroundService.stop(app)"))
+        assertTrue(src.contains("wm.cancelUniqueWork(IMMEDIATE_WORK)"))
+    }
+}
