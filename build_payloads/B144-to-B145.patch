@@ -0,0 +1,39 @@
+package tr.borsatakip.v5.ui
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class B145AutoScanUiPolicyTest {
+    @Test
+    fun enabledWithoutProviderShowsWaitingNotYahoo() {
+        val ui = BistAutoScanUiPolicy.resolve(
+            enabled = true,
+            productionBackendReady = false,
+            fallbackEnabled = false,
+            timeframeLabel = "5 DK",
+            useForegroundService = true,
+            isDaily = false
+        )
+        assertTrue(ui.detailsLine.contains("AÇIK"))
+        assertTrue(ui.detailsLine.contains("VERİ KAYNAĞI YOK"))
+        assertTrue(ui.statusLine.contains("VERİ KAYNAĞI YOK"))
+        assertFalse(ui.statusLine.contains("Yahoo"))
+        assertTrue(ui.waitingForProvider)
+    }
+
+    @Test
+    fun enabledFallbackExplicitlyShowsYahoo() {
+        val ui = BistAutoScanUiPolicy.resolve(true, false, true, "5 DK", true, false)
+        assertTrue(ui.statusLine.contains("Yahoo YEDEK/GECİKMELİ"))
+        assertFalse(ui.waitingForProvider)
+    }
+
+    @Test
+    fun disabledStateIsConsistent() {
+        val ui = BistAutoScanUiPolicy.resolve(false, false, false, "5 DK", true, false)
+        assertEquals("Otomatik tarama: KAPALI", ui.detailsLine)
+        assertEquals("Kapalı • manuel tarama", ui.statusLine)
+    }
+}
