+package tr.borsatakip.v5.ui
+
+/**
+ * B145: BIST otomatik tarama görünümündeki tüm durum metinlerini tek kaynaktan üretir.
+ * Böylece switch, timeframe özeti ve provider etiketi birbiriyle çelişmez.
+ */
+data class BistAutoScanUiState(
+    val detailsLine: String,
+    val statusLine: String,
+    val waitingForProvider: Boolean
+)
+
+object BistAutoScanUiPolicy {
+    fun resolve(
+        enabled: Boolean,
+        productionBackendReady: Boolean,
+        fallbackEnabled: Boolean,
+        timeframeLabel: String,
+        useForegroundService: Boolean,
+        isDaily: Boolean
+    ): BistAutoScanUiState {
+        if (!enabled) {
+            return BistAutoScanUiState(
+                detailsLine = "Otomatik tarama: KAPALI",
+                statusLine = "Kapalı • manuel tarama",
+                waitingForProvider = false
+            )
+        }
+
+        val detailsBase = "Otomatik tarama: AÇIK • Her $timeframeLabel"
+        if (!productionBackendReady && !fallbackEnabled) {
+            return BistAutoScanUiState(
+                detailsLine = "$detailsBase • VERİ KAYNAĞI YOK",
+                statusLine = "Açık • $timeframeLabel • VERİ KAYNAĞI YOK • bekliyor",
+                waitingForProvider = true
+            )
+        }
+
+        if (!productionBackendReady && fallbackEnabled) {
+            return BistAutoScanUiState(
+                detailsLine = "$detailsBase • Yahoo YEDEK/GECİKMELİ",
+                statusLine = "Açık • $timeframeLabel • Yahoo YEDEK/GECİKMELİ",
+                waitingForProvider = false
+            )
+        }
+
+        val status = when {
+            isDaily -> "Açık • gerçek 1 GÜN OHLCV • yaklaşık 24 saatte bir"
+            useForegroundService -> "Açık • $timeframeLabel OHLCV • her $timeframeLabel • foreground servis"
+            else -> "Açık • $timeframeLabel OHLCV • her $timeframeLabel • WorkManager"
+        }
+        return BistAutoScanUiState(
+            detailsLine = detailsBase,
+            statusLine = status,
+            waitingForProvider = false
+        )
+    }
+}
