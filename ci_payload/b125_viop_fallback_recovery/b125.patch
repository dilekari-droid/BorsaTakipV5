+        // Bu durumda adayın sessizce kaybolmaması için history'yi açıkça tamamlarız.
+        val embedded = quoteStock?.takeIf { closedBarCount(it) >= REQUIRED_CLOSED_BARS }
+        if (embedded != null) {
+            return OpportunityEngine.score(embedded)?.let { Candidate(contract, it, MODE_EMBEDDED) }
+        }
+
+        val hourly = runCatching {
+            provider.fetchHistory(symbol, nowMs - HOURLY_LOOKBACK_MS, nowMs, 60)
+        }.getOrDefault(emptyList()).sanitize()
+        if (hourly.size >= REQUIRED_SOURCE_BARS) {
+            val stock = stockWithHistory(quoteStock, symbol, hourly, "60m", nowMs)
+            val opportunity = OpportunityEngine.score(stock)
+            if (opportunity != null) return Candidate(contract, opportunity, MODE_60M)
+        }
+
+        val daily = runCatching { provider.fetchDailyHistory(symbol, maximumRange = true) }
+            .getOrDefault(emptyList()).sanitize()
