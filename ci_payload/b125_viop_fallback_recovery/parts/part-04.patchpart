+        findViewById<TextView>(R.id.heroContract).text = "${candidate.contract.symbol} • ${candidate.contract.expiry} • VİOP FİYATI DEĞİL"
+        findViewById<TextView>(R.id.heroExpiry).text = "${candidate.historyMode} referansı"
