--- /dev/null
+++ b/app/src/test/java/tr/borsatakip/v5/data/AutoScanActivationSourceTest.kt
@@ -0,0 +1,54 @@
+package tr.borsatakip.v5.data
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class AutoScanActivationSourceTest {
+    private fun mainRoot(): File {
+        val cwd = File(System.getProperty("user.dir"))
+        return sequenceOf(
+            File(cwd, "src/main"),
+            File(cwd, "app/src/main"),
+            cwd.parentFile?.let { File(it, "app/src/main") }
+        ).filterNotNull().firstOrNull { it.isDirectory }
+            ?: error("app/src/main bulunamadı: ${cwd.absolutePath}")
+    }
+
+    private fun source(path: String): String = File(mainRoot(), path).readText()
+
+    @Test
+    fun userCanEnableAutoScanBeforeBackendIsConfigured() {
+        val src = source("java/tr/borsatakip/v5/ui/BistScanActivity.kt")
+        assertTrue(src.contains("settings.autoScanEnabled = enabled"))
+        assertTrue(src.contains("OTOMATİK TARAMA AKTİF • VERİ SERVİSİ BEKLENİYOR"))
+        assertFalse(src.contains("if (enabled && !productionBackendConfigured()) {\n                settings.autoScanEnabled = false"))
+        assertFalse(src.contains("autoScanSwitch.isChecked = false"))
+    }
+
+    @Test
+    fun autoScanUiShowsEnabledWaitingStateInsteadOfForcedOff() {
+        val src = source("java/tr/borsatakip/v5/ui/BistScanActivity.kt")
+        assertTrue(src.contains("!productionBackendConfigured() -> \"Açık • ${'$'}{tf.label} • veri servisi bekleniyor\""))
+        assertFalse(src.contains("!productionBackendConfigured() -> \"Bekliyor • Production Backend gerekli\""))
+    }
+
+    @Test
+    fun foregroundServiceMayWaitForBackendWhileAutoScanRemainsEnabled() {
+        val src = source("java/tr/borsatakip/v5/worker/AutoScanForegroundService.kt")
+        assertTrue(src.contains("if (!settings.autoScanEnabled) return false"))
+        assertFalse(src.contains("if (!settings.autoScanEnabled || !settings.baseUrl.startsWith(\"https://\") || settings.apiKey.isBlank()) return false"))
+        assertTrue(src.contains("veri servisi yapılandırılmamış"))
+        assertTrue(src.contains("delay(cadence * 60_000L)"))
+    }
+
+    @Test
+    fun activityResumeReconcilesEnabledAutoScanEvenWhenBackendIsStillWaiting() {
+        val src = source("java/tr/borsatakip/v5/ui/BistScanActivity.kt")
+        assertTrue(src.contains("if (settings.autoScanEnabled) {\n                AutoScanScheduler.reconcile(this, allowForegroundStart = true)"))
+        assertFalse(src.contains("if (settings.autoScanEnabled && productionBackendConfigured())"))
+    }
+}
