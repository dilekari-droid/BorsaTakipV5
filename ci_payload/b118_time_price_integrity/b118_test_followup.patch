+package tr.borsatakip.v5.data
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class B118PriceIntegritySourceTest {
+    private fun mainRoot(): File {
+        val cwd = File(requireNotNull(System.getProperty("user.dir")))
+        return sequenceOf(
+            File(cwd, "src/main"),
+            File(cwd, "app/src/main"),
+            cwd.parentFile?.let { File(it, "app/src/main") }
+        ).filterNotNull().firstOrNull { it.isDirectory }
+            ?: error("app/src/main bulunamadı: ${cwd.absolutePath}")
+    }
+
+    private fun source(path: String): String = File(mainRoot(), path).readText()
+
+    @Test fun yahooFavoriteQuoteUsesIntradayMetadataButNeverClaimsRealtime() {
+        val src = source("java/tr/borsatakip/v5/data/YahooFallbackProvider.kt")
+        assertTrue(src.contains("fetchLatestDelayedQuote"))
+        assertTrue(src.contains("range=1d&interval=1m"))
+        assertTrue(src.contains("regularMarketPrice"))
+        assertTrue(src.contains("previousClose"))
+        assertTrue(src.contains("isRealtime = false"))
+    }
+
+    @Test fun favoritesOpenPathNoLongerPrefersOldAppSessionSnapshot() {
+        val src = source("java/tr/borsatakip/v5/ui/FavoritesActivity.kt")
+        assertFalse(src.contains("if (existing != null) {\n            openOpportunity(existing)\n            return"))
+        assertTrue(src.contains("displayQuotePrice"))
+        assertTrue(src.contains("eski tarama fiyatı gösterilmedi"))
+    }
+
+    @Test fun stockDetailRefreshesDisplayQuoteIndependentlyFromDecisionSnapshot() {
+        val src = source("java/tr/borsatakip/v5/ui/StockDetailActivity.kt")
+        assertTrue(src.contains("refreshDisplayedQuote()"))
+        assertTrue(src.contains("ProviderRouter(this@StockDetailActivity).fetchOne(x.symbol)"))
+        assertTrue(src.contains("YEDEK/GECİKMELİ FİYAT"))
+        assertTrue(src.contains("Teknik karar tarama anına aittir"))
+    }
+
+    @Test fun realtimeContractRequiresAtLeastCanonicalClosedBarReadiness() {
+        val src = source("java/tr/borsatakip/v5/data/RealtimeScannerClient.kt")
+        assertTrue(src.contains("minReadyBars >= CandleReadinessPolicy.requiredClosedBars()"))
+        assertTrue(src.contains("measuredAge"))
+        assertTrue(src.contains("ITEM_AGE_TOLERANCE_MS"))
+        assertTrue(src.contains("marketRegimeConfidence"))
+        assertFalse(src.contains("marketRegimeConfidence = if"))
+    }
+
+    @Test fun mtfUsesTrueDailyHistoryAndNoTopTwelvePreselection() {
+        val bist = source("java/tr/borsatakip/v5/scan/BistScanner.kt")
+        val viop = source("java/tr/borsatakip/v5/analysis/ViopScanner.kt")
+        assertTrue(bist.contains("fetchDailyHistory(opportunity.symbol, maximumRange = false)"))
+        assertFalse(bist.contains("MAX_MTF_CANDIDATES"))
+        assertFalse(viop.contains("MAX_MTF_CANDIDATES"))
+        assertTrue(viop.contains("MTF_CONCURRENCY"))
+    }
+
+    @Test fun adaptiveStrategyTrainingExcludesWatchOnlyRecords() {
+        val src = source("java/tr/borsatakip/v5/data/SignalHistoryStore.kt")
+        assertTrue(src.contains("DecisionState.VERIFIED_OPPORTUNITY.name"))
+        assertTrue(src.contains("WATCH records remain in history"))
+    }
+
+    @Test fun favoriteCardReturnedToSimplePreviousStructure() {
+        val xml = source("res/layout/item_favorite.xml")
+        assertTrue(xml.contains("favoriteSymbol"))
+        assertTrue(xml.contains("favoriteCompany"))
+        assertTrue(xml.contains("favoriteDetails"))
+        assertTrue(xml.contains("favoriteRemove"))
+        assertFalse(xml.contains("favoriteBid"))
+        assertFalse(xml.contains("favoriteAsk"))
+        assertFalse(xml.contains("favoriteSignal"))
+    }
+}
