+package tr.borsatakip.v5.analysis
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import tr.borsatakip.v5.model.Candle
+import tr.borsatakip.v5.model.Stock
+
+class B118TemporalIntegrityTest {
+    @Test fun incompleteThreeMinuteBucketIsRejected() {
+        val t = 1_800_000_000_000L - (1_800_000_000_000L % 180_000L)
+        val input = listOf(c(t, 100.0), c(t + 120_000L, 102.0))
+        assertTrue(OhlcvResampler.aggregate(input, 3).isEmpty())
+    }
+
+    @Test fun completeThreeMinuteBucketIsAccepted() {
+        val t = 1_800_000_000_000L - (1_800_000_000_000L % 180_000L)
+        val input = listOf(c(t, 100.0), c(t + 60_000L, 101.0), c(t + 120_000L, 102.0))
+        val out = OhlcvResampler.aggregate(input, 3)
+        assertEquals(1, out.size)
+        assertEquals(100.0, out.single().open, 0.0)
+        assertEquals(102.0, out.single().close, 0.0)
+        assertEquals(3_000.0, out.single().volume, 0.0)
+    }
+
+    @Test fun supportResistanceExcludeSignalCandle() {
+        val base = 1_700_000_000_000L
+        val candles = (0 until 30).map { i ->
+            Candle(base + i * 60_000L, 100.0, 110.0, 90.0, 100.0, 1_000.0)
+        }.toMutableList()
+        candles[candles.lastIndex] = Candle(base + 29 * 60_000L, 100.0, 101.0, 50.0, 95.0, 1_000.0)
+        val technical = TechnicalAnalyzer.analyze(candles)
+        assertEquals(90.0, technical.support!!, 0.0)
+        assertEquals(110.0, technical.resistance!!, 0.0)
+    }
+
+    @Test fun confirmedOpportunityUsesClosedBarPriceNotQuotePrice() {
+        val base = 1_650_000_000_000L
+        val candles = (0 until 220).map { i ->
+            val px = 80.0 + i * 0.05
+            Candle(base + i * 86_400_000L, px, px + 0.8, px - 0.8, px, 1_000.0 + i)
+        }
+        val stock = Stock(
+            symbol = "TEST",
+            companyName = "Test",
+            candles = candles,
+            source = "Yahoo Finance • YEDEK/GECİKMELİ",
+            dataTimestamp = candles.last().timestamp,
+            isRealtime = false,
+            quotePrice = 999.0,
+            interval = "1d",
+            lastBarClosed = true,
+            previousClose = candles[candles.lastIndex - 1].close
+        )
+        val opportunity = OpportunityEngine.score(stock)
+        assertNotNull(opportunity)
+        assertEquals(candles.last().close, opportunity!!.price, 0.0)
+    }
+
+    @Test fun canonicalRankingUsesAllDocumentedFactors() {
+        val score = OpportunityRankingPolicy.compose(
+            technicalScore = 80,
+            dataConfidence = 80,
+            riskScore = 20,
+            rr = 3.0,
+            volumeRatio = 2.0,
+            freshnessScore = 100
+        )
+        // 36 + 20 + 8 + 10 + 5 + 5 = 84
+        assertEquals(84, score)
+    }
+
+    private fun c(timestamp: Long, close: Double) = Candle(
+        timestamp = timestamp,
+        open = close,
+        high = close + 0.5,
+        low = close - 0.5,
+        close = close,
+        volume = 1_000.0
+    )
+}
