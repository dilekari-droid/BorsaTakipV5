+        "BIST30" -> "BIST 30"
+        "USDTRY" -> "DOLAR / TL"
+        "XAUUSD" -> "ONS ALTIN"
+        "VIOP30" -> "VİOP 30"
+        else -> "Piyasa Detayı"
+    }
+
+    companion object {
+        const val EXTRA_INSTRUMENT = "market_instrument"
+    }
+}
