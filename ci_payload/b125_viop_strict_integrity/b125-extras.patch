+package tr.borsatakip.v5.data
+
+/** Explicit provider ticker mapping for delayed underlying-reference mode. */
+object ViopUnderlyingTickerMap {
+    fun yahooTickers(underlying: String): List<String> = when (val u = underlying.trim().uppercase()) {
+        "USDTRY" -> listOf("TRY=X", "USDTRY=X")
+        "EURTRY" -> listOf("EURTRY=X")
+        "GOLD" -> listOf("GC=F")
+        "SILVER" -> listOf("SI=F")
+        "BRENT" -> listOf("BZ=F")
+        "XU030" -> listOf("XU030.IS", "^XU030", "XU030")
+        else -> if (u.matches(Regex("[A-Z0-9_]{3,12}"))) listOf("$u.IS") else emptyList()
+    }
+
+    fun isExternalReference(underlying: String): Boolean =
+        underlying.trim().uppercase() in setOf("USDTRY", "EURTRY", "GOLD", "SILVER", "BRENT", "XU030")
+}
