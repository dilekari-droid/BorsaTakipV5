+package tr.borsatakip.v5.data
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class B125ViopSourceContractTest {
+    private fun read(path: String) = File(path).readText()
+
+    @Test fun quoteAndHistoryRequireExplicitSymbolIdentity() {
+        val s = read("src/main/java/tr/borsatakip/v5/data/BackendProvider.kt")
+        assertTrue(s.contains("QUOTE_ERROR: Sembol kimliği eksik."))
+        assertTrue(s.contains("HISTORY_ERROR: Sembol kimliği eksik."))
+        assertFalse(s.contains("optString(\"symbol\").ifBlank { symbol }"))
+    }
+
+    @Test fun historyRejectsMalformedBarsInsteadOfFilteringThem() {
+        val s = read("src/main/java/tr/borsatakip/v5/data/BackendProvider.kt")
+        assertTrue(s.contains("nesne değil"))
+        assertTrue(s.contains("lastBarClosed eksik"))
+        assertTrue(s.contains("lastBarTime son mumla eşleşmiyor"))
+        assertFalse(s.contains(".distinctBy{it.timestamp}.sortedBy{it.timestamp}"))
+    }
+
+    @Test fun versionCodeIs125() {
+        assertTrue(read("build.gradle.kts").contains("versionCode = 125"))
+    }
+}
