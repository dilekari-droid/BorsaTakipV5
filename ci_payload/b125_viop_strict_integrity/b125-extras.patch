+package tr.borsatakip.v5.data
+
+import org.junit.Assert.*
+import org.junit.Test
+import tr.borsatakip.v5.analysis.DecisionPricePolicy
+import tr.borsatakip.v5.model.Candle
+
+class B125ViopStrictIntegrityTest {
+    @Test fun decisionPriceNeverFallsBackToLiveQuote() {
+        assertNull(DecisionPricePolicy.historyBarPrice(emptyList()))
+    }
+
+    @Test fun decisionPriceUsesValidatedHistoryClose() {
+        val c = Candle(1_700_000_000_000L, 100.0, 103.0, 99.0, 102.0, 1_000.0)
+        assertEquals(102.0, DecisionPricePolicy.historyBarPrice(listOf(c)) ?: 0.0, 0.0001)
+    }
+
+    @Test fun viopExternalTickerMappingsAreExplicit() {
+        assertEquals(listOf("TRY=X", "USDTRY=X"), ViopUnderlyingTickerMap.yahooTickers("USDTRY"))
+        assertEquals(listOf("GC=F"), ViopUnderlyingTickerMap.yahooTickers("GOLD"))
+        assertEquals(listOf("BZ=F"), ViopUnderlyingTickerMap.yahooTickers("BRENT"))
+        assertEquals(listOf("AKBNK.IS"), ViopUnderlyingTickerMap.yahooTickers("AKBNK"))
+    }
+
+    @Test fun mtfCacheRejectsStaleExchangeTimeWhenGuarded() = kotlinx.coroutines.runBlocking {
+        MtfHistoryCache.clear()
+        val now = 1_700_000_600_000L
+        val stale = listOf(Candle(now - 10 * 60_000L, 10.0, 11.0, 9.0, 10.5, 100.0))
+        val result = MtfHistoryCache.loadFresh(
+            sourceKey = "VIOP_BACKEND", symbol = "F_X", timeframe = "1m", ttlMs = 30_000L,
+            maxExchangeAgeMs = 2 * 60_000L, nowMs = { now }, loader = { stale }
+        )
+        assertTrue(result.isEmpty())
+    }
+
+    @Test fun mtfCacheAcceptsFreshExchangeTimeWhenGuarded() = kotlinx.coroutines.runBlocking {
+        MtfHistoryCache.clear()
+        val now = 1_700_000_600_000L
+        val fresh = listOf(Candle(now - 30_000L, 10.0, 11.0, 9.0, 10.5, 100.0))
+        val result = MtfHistoryCache.loadFresh(
+            sourceKey = "VIOP_BACKEND", symbol = "F_X", timeframe = "1m", ttlMs = 30_000L,
+            maxExchangeAgeMs = 2 * 60_000L, nowMs = { now }, loader = { fresh }
+        )
+        assertEquals(1, result.size)
+    }
+}
